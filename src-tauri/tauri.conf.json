{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-view",
  "version": "0.1.0",
  "identifier": "com.zhuyuchen.cc-view",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "width": 560,
        "height": 420,
        "center": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "prefs",
        "url": "index.html",
        "visible": false,
        "decorations": true,
        "resizable": false,
        "width": 480,
        "height": 460,
        "center": true,
        "skipTaskbar": false,
        "title": "cc-view 偏好设置"
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "tooltip": "cc-view",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "exceptionDomain": "",
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MDhBQ0FGNDg4NDY1NkUKUldSdVpZUklyNndJTk9SS3dnR1EvMjFmMHZYRFJDQ3A1N0dLR1JzemV1Zzk2TG9aYlQzWElhTHIK",
      "endpoints": [
        "https://github.com/Ethanzyc/cc-view/releases/latest/download/latest.json"
      ]
    }
  }
}
