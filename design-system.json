{
  "meta": {
    "id": "macos-status-quiet",
    "name": "macOS 状态指挥台 · 克制",
    "version": "1.0",
    "createdAt": "2026-08-03",
    "axis": {
      "colorMood": "minimal",
      "typeMood": "modern",
      "density": "compact",
      "motionTone": "subtle",
      "material": "flat-glass"
    },
    "tags": ["macOS", "菜单栏", "状态监控", "克制", "毛玻璃", "指挥台"],
    "useCase": "常驻菜单栏/桌面状态指挥台 + 全局快捷命令面板"
  },
  "color": {
    "light": {
      "bg": "transparent",
      "fg": "#1D1D1F",
      "muted": "#6E6E73",
      "tertiary": "#6E6E73",
      "primary": "#0A84FF",
      "accent": "#0A84FF",
      "border": "rgba(0, 0, 0, 0.08)",
      "hover": "rgba(0, 0, 0, 0.06)"
    },
    "dark": {
      "bg": "transparent",
      "fg": "#E5E5E7",
      "muted": "#AEAEB2",
      "tertiary": "#8E8E93",
      "primary": "#0A84FF",
      "accent": "#0A84FF",
      "border": "rgba(255, 255, 255, 0.08)",
      "hover": "rgba(255, 255, 255, 0.08)"
    },
    "semantic": {
      "working": "#30D158",
      "waitingForInput": "#0A84FF",
      "needsPermission": "#FF9F0A",
      "shell": "#BF5AF2",
      "compacting": "#64D2FF"
    }
  },
  "typography": {
    "body": "-apple-system, 'PingFang SC', 'SF Pro Text', sans-serif",
    "utility": "'SF Mono', ui-monospace, 'Menlo', monospace",
    "scale": [
      { "role": "display", "size": "13px", "weight": 700, "lineHeight": 1.3 },
      { "role": "body", "size": "13px", "weight": 600, "lineHeight": 1.25 },
      { "role": "caption", "size": "11px", "weight": 400, "lineHeight": 1.3 },
      { "role": "utility", "size": "10px", "weight": 400, "lineHeight": 1.3 },
      { "role": "control", "size": "15px", "weight": 400, "lineHeight": 1 }
    ]
  },
  "layout": {
    "density": "compact",
    "hud": { "width": "340px", "radius": "10px", "rowHeight": "36px" },
    "overlay": { "width": "560px", "radius": "12px", "rowHeight": "36px" },
    "padding": { "x": "12px", "y": "8px" },
    "spacing": { "gap": "8px", "gapSm": "6px", "gapXs": "4px", "spaceEmpty": "40px" },
    "divider": "1px"
  },
  "motion": {
    "duration": "160ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "curveRef": "subtle-enter",
    "signature": {
      "breathe": {
        "duration": "2400ms",
        "easing": "ease-in-out",
        "opacityRange": [1, 0.5],
        "reducedMotion": "static"
      }
    }
  },
  "signature": {
    "description": "Working 状态指示灯呼吸：Working（在跑）的状态图标 opacity 1↔0.5 缓慢呼吸（~2.4s），像服务状态灯/活动监视器的心跳——'活着'的语义可视化。只 Working 呼吸、其余状态静止；呼吸是唯一的动态信号。",
    "implementation": "Working 状态的 StatusIcon 套 @keyframes breathe {0%,100%{opacity:1} 50%{opacity:0.5}} 周期 2.4s ease-in-out infinite；@media (prefers-reduced-motion: reduce) 设 animation:none 降级静态。仅作用于 status==='working'。"
  }
}
